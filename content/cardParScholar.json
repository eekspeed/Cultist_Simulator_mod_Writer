    {
      "id": "p_calvin_a",
      "label": "熟人加尔文",
      "description": "人的得救与否由上帝决定，但世俗的得救由人决定。（约翰·加尔文，1509—1564，法国神学家、宗教改革家，加尔文主义创始人。）",
      "aspects": {
        "acquaintance": 1,
        "aspect_supernatural": 1,
        "aspect_level": 6,
        "aspect_scholar": 1,
        "aspect_scholar_lantern": 1
